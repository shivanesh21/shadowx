# ShadowX Factory Configuration
# Copy this file to .env and insert your Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default model: gemini-3.5-flash-lite (fast/cost-effective) or gemini-2.5-flash
MODEL_NAME=gemini-3.5-flash-lite

# Optional Factory Settings
SHADOWX_ENV=development
MAX_DEBUG_ITERATIONS=4
